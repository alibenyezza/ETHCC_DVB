# === CRE Workflow Secrets ===
# Used by ConfidentialHTTPClient to authenticate with agent API
ARCMIND_AGENT_API_KEY=

# TEE enclave signing key
TEE_PRIVATE_KEY_VAR=

# === Standalone Mode ===
# Agent API URL (default: http://localhost:3100)
AGENT_API_URL=http://localhost:3100

# TEE cycle interval in ms (default: 30000)
TEE_CYCLE_MS=30000

# === RPC Endpoints ===
ARC_RPC=https://rpc.testnet.arc.network
ETH_SEPOLIA_RPC=https://ethereum-sepolia-rpc.publicnode.com
BASE_SEPOLIA_RPC=https://sepolia.base.org
ARB_SEPOLIA_RPC=https://sepolia-rollup.arbitrum.io/rpc
AVAX_FUJI_RPC=https://api.avax-test.network/ext/bc/C/rpc
OP_SEPOLIA_RPC=https://sepolia.optimism.io

# === 0G Chain (attestations) ===
ZG_CHAIN_RPC=https://evmrpc-testnet.0g.ai
